APP_ENV=local
APP_NAME=知源内容工作台
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AIHOT: disabled in direct/server deployments. The loopback-only start.sh enables it
# for personal non-commercial use. External products require written source authorization.
# AIHOT_ENABLED=false
# GitHub release metadata; local launcher enables it, direct/server starts default off.
# GITHUB_ENABLED=false

# scripts/start.sh 默认使用 .data/demo.db，无需配置数据库。
# 如直接启动 uvicorn，可配置 SQLite 绝对路径或已有 MySQL。
# DATABASE_URL=sqlite:////absolute/project/path/.data/demo.db

DEFAULT_LLM_PROVIDER=local
DEFAULT_LLM_MODEL=local-rule-based-v0

# 可选：按 provider/model 精确匹配的运营核验价格。留空数组时费用未知，不填零。
# version 是你核对价格时登记的版本；currency 为 3 位币种；费率单位为每百万 token。
# 下例只是虚构配置格式，不是供应商价格；不要直接用于真实费用估算。
# MODEL_PRICING_JSON='[{"provider":"synthetic","model":"test-model","version":"synthetic-v1","currency":"CNY","input_per_million":"1","output_per_million":"2"}]'
MODEL_PRICING_JSON=[]
# 估算仅使用已知输入/输出 token，不含缓存折扣、工具、税费或供应商账单调整。
# 无价格、缺用量、调用失败时 estimated_cost 均为空；本地规则无外部模型费用记录。

# 所有凭证留空；页面选择供应商后才对该任务使用它。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=

# 默认启动脚本启用 semantic；临时切换用：
# RAG_RETRIEVAL_MODE=lexical ./scripts/start.sh
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_SEMANTIC_MIN_SCORE=0.55

# 可选 OpenAI-compatible Embedding；需同时改 provider、model 并重建索引。
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_BASE_URL=https://your-service.example/v1
# RAG_EMBEDDING_API_KEY=
