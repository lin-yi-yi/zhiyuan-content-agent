# 本机试点。运行 ./scripts/start_saas.sh；不会读取旧版 .env。
SAAS_MODE=true
SAAS_PORT=8766
SAAS_PUBLIC_ORIGIN=http://127.0.0.1:8766
SAAS_SECURE_COOKIE=false
SAAS_ALLOW_REGISTRATION=true
SAAS_MAX_ORGANIZATIONS=100
SAAS_MAX_OWNED_ORGANIZATIONS=3
# 公开试点建议设 false，仅允许已有账号登录或受邀注册。
# SAAS_DATA_DIR=/absolute/path/to/saas-data
RAG_RETRIEVAL_MODE=semantic
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
GITHUB_ENABLED=true
AIHOT_ENABLED=false
AIHOT_COMMERCIAL_AUTHORIZED=false
# 运营方确认上游书面商业授权后，才允许开放 AIHOT。
# 模型密钥由运营方配置；每个组织仍需在连接中心主动开启。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-1-5-pro-32k
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
